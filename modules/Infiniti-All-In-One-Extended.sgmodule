#!name=Infiniti All-in-One Ultimate v3.3 - ALL 39 ACTIVE
#!desc=Full combined experimental module: 39 unique ACTIVE JS declarations plus MITM/Rewrites
#!author=infiniti-money; third-party script copyright belongs to respective authors
#!homepage=https://github.com/infiniti-money/Shadowrocket
#!url=https://raw.githubusercontent.com/infiniti-money/Shadowrocket/main/modules/Infiniti-All-In-One-Extended.sgmodule

# ONE-URL ULTIMATE EXPERIMENTAL v3.2 — other overlapping modules MUST be disabled.
# Covers original 10in1, All_In_One and separately researched JS sources.
# RevenueCat is a shared API affecting unrelated apps; test with caution.
# Script existence, URL response and device compatibility are NOT guaranteed.
# No CA private key or password is included. Set up HTTPS trust locally if authorized.
# Never enable with other all-in-one, Spotify, Locket or YouTube modules.
# Restore non-MITM version: modules/Infiniti-All-In-One.sgmodule

[Rule]
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Advertising/Advertising.list,REJECT
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Privacy/Privacy.list,REJECT
RULE-SET,https://raw.githubusercontent.com/bigdargon/hostsVN/master/extensions/threat/surge-rule.conf,REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Header Rewrite]
http-request '^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$)' header-del x-revenuecat-etag
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[Url Rewrite]
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) _ reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject-200
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad 'data-type=text data="" status-code=200'

# v3.3: ALL 39 unique script source URLs have active script entries per explicit user request.
# 20 sources previously 404. Their rules are present but may FAIL TO DOWNLOAD/RUN.
# Overlapping Spotify, YouTube and RevenueCat handlers may conflict.
# This is an experimental source merge, NOT a working Premium guarantee.
# No CA private key or ca-passphrase is embedded. HTTPS trust is device-local.
# Disable every overlapping standalone module and use only an authorized test device.

[Script]
SRC_01_Sub_Store_Core = type=http-request,pattern=^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))),script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-1.min.js,requires-body=true,timeout=120
SRC_02_Sub_Store_Simple = type=http-request,pattern=^https?:\/\/sub\.store,script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-0.min.js,requires-body=true
SRC_03_Sub_Store_Sync = type=cron,cronexp=0 0 * * *,wake-system=1,timeout=120,script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/cron-sync-artifacts.min.js
# PREVIOUSLY-404 — SRC_04_youtube_request
SRC_04_youtube_request = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|reel\/reel_watch_sequence|get_watch),requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,script-path=https://raw.githubusercontent.com/duyvinh09/Module_IOS/refs/heads/main/js/youtube.response.js
SRC_05_spotify_json = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-json.js
SRC_06_spotify_proto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-proto.js,script-update-interval=0
# PREVIOUSLY-404 — SRC_07_SoundCloudGo_
